# Neon Postgres. All tables live under the `morpho_` schema.
# Set in three places:
#   - Local:  copy to .env (gitignored). Used by scripts/apply-schema.ts.
#   - Web:    add to Vercel project env (Production + Preview).
#   - Worker: `wrangler secret put DATABASE_URL` in apps/worker.
DATABASE_URL=

# Optional override — only set if you want apply-schema.ts to target a Neon branch
# other than the one in DATABASE_URL.
# DATABASE_BRANCH=
